{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data-display/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/jeep-uae-website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:BrandFont|BrandFontMedium|Roboto))/i]",
        "message": "Font not provided by the design system. Available: BrandFont, BrandFontMedium, Roboto."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|dark|light)$/]",
        "message": "<Badge> tone must be one of 'brand' | 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|href|iconBefore|iconAfter|disabled|fullWidth|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, href, iconBefore, iconAfter, disabled, fullWidth, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tertiary|pill|link)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'tertiary' | 'pill' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CarouselIndicators'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|active|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<CarouselIndicators> doesn't accept that prop. Declared props: count, active, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<CategoryHeading> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|children|layout|iconTone|style|key|ref|className|style|children)$/]",
        "message": "<FeatureItem> doesn't accept that prop. Declared props: icon, title, children, layout, iconTone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureItem'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:stacked|inline)$/]",
        "message": "<FeatureItem> layout must be one of 'stacked' | 'inline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureItem'] > JSXAttribute[name.name='iconTone'] > Literal[value!=/^(?:default|brand)$/]",
        "message": "<FeatureItem> iconTone must be one of 'default' | 'brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|social|logos|legal|copyright|onBackToTop|backToTopIcon|style|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: columns, social, logos, legal, copyright, onBackToTop, backToTopIcon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Header'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|items|activeItem|onSelect|actions|languageLabel|style|key|ref|className|style|children)$/]",
        "message": "<Header> doesn't accept that prop. Declared props: logo, items, activeItem, onSelect, actions, languageLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|size|tone|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: src, alt, size, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|brand|white|invert)$/]",
        "message": "<Icon> tone must be one of 'default' | 'brand' | 'white' | 'invert'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InPageMenu'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|items|activeItem|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<InPageMenu> doesn't accept that prop. Declared props: label, items, activeItem, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:bordered|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: bordered."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|htmlFor|required|tone|style|key|ref|className|style|children)$/]",
        "message": "<Label> doesn't accept that prop. Declared props: children, htmlFor, required, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<Label> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModelCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|priceFrom|monthlyFrom|image|infoIcon|currency|viewHref|configureHref|onView|onConfigure|style|key|ref|className|style|children)$/]",
        "message": "<ModelCard> doesn't accept that prop. Declared props: name, priceFrom, monthlyFrom, image, infoIcon, currency, viewHref, configureHref, onView, onConfigure, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|align|underline|tone|style|key|ref|className|style|children)$/]",
        "message": "<SectionTitle> doesn't accept that prop. Declared props: children, align, underline, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionTitle> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<SectionTitle> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:bordered|placeholder|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: bordered, placeholder."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|children|style|key|ref|className|style|children)$/]",
        "message": "<StepTile> doesn't accept that prop. Declared props: index, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|activeItem|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: items, activeItem, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='UsedCarCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|price|monthly|image|meta|currency|badge|href|onView|style|key|ref|className|style|children)$/]",
        "message": "<UsedCarCard> doesn't accept that prop. Declared props: title, price, monthly, image, meta, currency, badge, href, onView, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
